# --- Kakao Developers (https://developers.kakao.com) ---
# 내 애플리케이션 → 앱 키 → "REST API 키"
KAKAO_REST_API_KEY=
# 보안 → Client Secret 사용 ON 인 경우 필수 (사용 OFF 면 비워둬도 됨)
KAKAO_CLIENT_SECRET=
# 내 애플리케이션 → 카카오 로그인 → "Redirect URI"에 등록한 값과 동일해야 함
KAKAO_REDIRECT_URI=http://localhost:8000/api/kakao/callback

# --- App ---
DATABASE_URL=sqlite:///./golf.db
POLL_INTERVAL_SECONDS=60
# 알림 링크에 쓰일 프론트엔드 base URL
FRONTEND_BASE_URL=http://localhost:5173
# 데모 크롤러 활성화 (실제 크롤러 검증 전까지 true 권장)
ENABLE_DEMO_CRAWLER=true

# --- XGOLF ---
# 브라우저 DevTools → Network → 잔여조회 요청 → cURL 의 Cookie 헤더 값 그대로
# 세션 만료 시 갱신 필요. 빈 값이면 XGOLF 크롤러는 항상 빈 결과 반환
XGOLF_COOKIE=
XGOLF_AGENT_CODE=77
XGOLF_LOOKAHEAD_DAYS=21
